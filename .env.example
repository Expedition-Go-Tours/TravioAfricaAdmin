# TravioAfrica Admin Dashboard — Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL — leave blank to use Vite proxy (dev) or set for production
# VITE_API_URL=https://api.travioafrica.com/api

# Google OAuth Client ID (for One Tap login)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
